{
  "name": "forma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler d1 migrations apply forma --local && wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply forma --remote",
    "db:migrate": "wrangler d1 migrations apply forma --remote",
    "db:migrate:local": "wrangler d1 migrations apply forma --local",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
